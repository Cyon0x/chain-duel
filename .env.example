# ---------------------------------------------------------------------------
# Chain Duel environment
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# Public URL of the deployment. Used for OAuth redirect URIs and the SIWS domain.
APP_URL=http://localhost:4310
NODE_ENV=development

# --- Database --------------------------------------------------------------
# Postgres connection string. REQUIRED in production (Supabase, Neon, ...).
# When unset the app uses SQLite: ./chain-duel.db in dev, in-memory in prod.
# DATABASE_URL=postgresql://user:password@host:5432/chain_duel?sslmode=require

# Local SQLite file path (development only). ":memory:" for a throwaway database.
CHAIN_DUEL_DB_PATH=./chain-duel.db

# --- Session + wallet encryption -------------------------------------------
# 32+ random characters each. Production refuses to start without them.
#   openssl rand -base64 32
SESSION_SECRET=
WALLET_ENCRYPTION_KEY=

# --- Stellar network -------------------------------------------------------
# testnet | futurenet | mainnet | local
STELLAR_NETWORK=testnet
# Override only if you run your own RPC/Horizon. Defaults come from the network.
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Soroban escrow --------------------------------------------------------
# Deployed Chain Duel contract id (C...). Empty = escrow features disabled.
CHAIN_DUEL_CONTRACT_ID=
# Stellar Asset Contract used for entries/payouts. Defaults to native XLM (SAC).
CHAIN_DUEL_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# --- Settlement / admin authority ------------------------------------------
# The developer/admin wallet address: the only address that can withdraw from the
# protocol treasury, and the account that holds admin rights in the contract.
ADMIN_WALLET_ADDRESS=
# Server-only signing key for settlement. NEVER expose this to the browser.
SETTLEMENT_SECRET_KEY=
# Optional alias, read only if SETTLEMENT_SECRET_KEY is unset.
# TREASURY_SECRET_KEY=

# --- OAuth (optional) ------------------------------------------------------
# Google: redirect URI https://<APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X: redirect URI https://<APP_URL>/api/auth/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Features --------------------------------------------------------------
# Enables the demo sign-in / no-stake demo duels used by judges.
DEMO_MODE_ENABLED=true

