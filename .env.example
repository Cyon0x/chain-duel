# ---------------------------------------------------------------------------
# Chain Duel environment
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# Public URL of the deployment. Used for OAuth redirect URIs and the SIWS domain.
APP_URL=http://localhost:4310
NODE_ENV=development

# --- Database --------------------------------------------------------------
# Postgres connection string. REQUIRED in production (Supabase, Neon, ...).
# When unset the app uses SQLite locally. Durable Postgres is required for
# production financial operations and for the shared Mainnet signing coordinator.
# DATABASE_URL=postgresql://user:password@host:5432/chain_duel?sslmode=require

# Local SQLite file path (development only). ":memory:" for a throwaway database.
CHAIN_DUEL_DB_PATH=./chain-duel.db

# --- Session + wallet encryption -------------------------------------------
# 32+ random characters each. Production refuses to start without them.
#   openssl rand -base64 32
SESSION_SECRET=
WALLET_ENCRYPTION_KEY=

# --- Scheduled maintenance (optional) --------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. When set, the daily
# maintenance sweep refunds expired duels and settles abandoned matches.
# CRON_SECRET=

# --- Stellar network -------------------------------------------------------
# testnet | futurenet | mainnet | local
STELLAR_NETWORK=testnet

# Independent Pulse replay preview. Never enable Mainnet before owner review.
STELLAR_PLAYER_SIGNING_MODE=legacy
STELLAR_VERIFICATION_VERSION=0
CHAIN_DUEL_VERIFIED_CONTRACT_ID=
STELLAR_VERIFIED_WASM_HASH=
STELLAR_VERIFIED_MAINNET_APPROVED=false
# Public build pins must match the independently verified Testnet deployment.
NEXT_PUBLIC_STELLAR_VERIFIED_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_VERIFIED_WASM_HASH=
NEXT_PUBLIC_STELLAR_VERIFIED_NETWORK=testnet
# Override only if you run your own RPC/Horizon. Defaults come from the network.
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Production cutover, after the deployment and all three verification passes:
# STELLAR_NETWORK=mainnet
# STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
# STELLAR_HORIZON_URL=https://horizon.stellar.org
# STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

# --- Soroban escrow --------------------------------------------------------
# Deployed Chain Duel contract id (C...). Empty = escrow features disabled.
CHAIN_DUEL_CONTRACT_ID=
# Stake revision for NEW games. Keep the original ID above for existing duels.
CHAIN_DUEL_STAKE_CONTRACT_ID=
# Independently deployed Mainnet escrow, recorded by stellar-mainnet-deploy.mjs.
# Never put a historical Testnet contract or the USDC token contract here.
CHAIN_DUEL_MAINNET_CONTRACT_ID=
# Empty selects the canonical asset for STELLAR_NETWORK: Testnet XLM or Mainnet
# Circle USDC. A Mainnet override must equal this exact official USDC SAC:
# CHAIN_DUEL_TOKEN_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
CHAIN_DUEL_TOKEN_ID=
# Preserve historical Testnet games, refunds, settlements and XLM history.
CHAIN_DUEL_TESTNET_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# --- Mainnet launch gates --------------------------------------------------
# Leave disabled until the settlement trust decision, contract review and actual
# owner-only Mainnet financial tests have been recorded. Offline tests alone do
# not establish production readiness.
STELLAR_MAINNET_CONTRACT_REVIEWED=false
STELLAR_MAINNET_GAMING_ENABLED=false
STELLAR_MAINNET_E2E_VERIFIED=false
# Comma-separated existing owner test-user IDs. Requires CONTRACT_REVIEWED=true.
STELLAR_MAINNET_VALIDATION_USER_IDS=
# Server-only shared durable Postgres coordinator. All deployments signing for
# the same Mainnet wallet must use the SAME coordinator, including isolated
# Preview apps and the deployment runner. Never use an independent Preview
# coordinator for a wallet also signing in production.
STELLAR_SIGNER_DATABASE_URL=

# --- Settlement / admin authority ------------------------------------------
# The developer/admin wallet address: the only address that can withdraw from the
# protocol treasury, and the account that holds admin rights in the contract.
ADMIN_WALLET_ADDRESS=GCQKVXWIQHVGUOUHZR2O6YBWBNNPKIYH5AWQHXHF3EYRHM73WIWVSK7K
# Server-only signing key for settlement. NEVER expose this to the browser.
# It must derive ADMIN_WALLET_ADDRESS. Reuse the existing secure key; do not
# generate a replacement deployment or administrator wallet.
SETTLEMENT_SECRET_KEY=
# Optional alias, read only if SETTLEMENT_SECRET_KEY is unset.
# TREASURY_SECRET_KEY=

# --- OAuth (optional) ------------------------------------------------------
# Google: redirect URI https://<APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X: redirect URI https://<APP_URL>/api/auth/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Features --------------------------------------------------------------
# Enables the demo sign-in / no-stake demo duels used by judges.
DEMO_MODE_ENABLED=true

# Arc is independent from Stellar. Mainnet defaults are official Arc endpoints.
ARC_NETWORK=mainnet
ARC_WALLETS_ENABLED=false
ARC_GAMING_ENABLED=false
ARC_CONTRACT_REVIEWED=false
# Server-side Circle API key; use separate Preview/Testnet and Production keys.
CIRCLE_API_KEY=
# Public Circle User-Controlled Wallets application ID (not a secret).
NEXT_PUBLIC_CIRCLE_APP_ID=
# Arc Google OAuth is independent of the existing Stellar Google client.
ARC_GOOGLE_CLIENT_ID=
ARC_GOOGLE_CLIENT_SECRET=
ARC_X_CLIENT_ID=
ARC_X_CLIENT_SECRET=
ARC_DUEL_CONTRACT_ADDRESS=
ARC_SETTLEMENT_PRIVATE_KEY=
# Local signing alternative: private file outside this repository.
ARC_SETTLEMENT_KEY_FILE=
# Deployment parameters: all recipient addresses must be explicitly configured.
ARC_DEPLOYER_KEY_FILE=
ARC_OWNER_ADDRESS=
ARC_SETTLEMENT_AUTHORITY=
ARC_PROTOCOL_FEE_RECIPIENT=
ARC_ECOSYSTEM_FEE_RECIPIENT=
ARC_BOT_TREASURY=
ARC_MIN_STAKE_USDC=0.50
ARC_MAX_STAKE_USDC=1000
ARC_REVIEW_REPORT=

# CCTP stays disabled until both real transfer directions and recovery are verified.
# CCTP's Stellar USDC environment follows ARC_NETWORK independently of the
# Stellar gaming network; historical Testnet recovery stays available.
BRIDGE_ENABLED=false
BRIDGE_E2E_VERIFIED=false
BRIDGE_VALIDATION_ENABLED=false
BRIDGE_VALIDATION_USER_ID=
BRIDGE_SECURITY_REVIEWED=false

