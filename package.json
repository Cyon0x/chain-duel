{
  "name": "chain-duel",
  "version": "1.0.0",
  "private": true,
  "description": "Chain Duel — premium 1v1 competitive arcade game powered by Stellar",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 4310",
    "dev:webpack": "next dev --webpack -p 4310",
    "build": "next build --webpack",
    "start": "next start -p 4310",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "test:contract": "node scripts/cargo.mjs test --manifest-path contracts/chain_duel/Cargo.toml",
    "contract:wasm": "node scripts/stellar-build.mjs --manifest-path contracts/chain_duel/Cargo.toml",
    "contract:wasm:mainnet": "node scripts/stellar-build.mjs --manifest-path contracts/chain_duel_mainnet/Cargo.toml",
    "test:contract:mainnet": "node scripts/cargo.mjs test --manifest-path contracts/chain_duel_mainnet/Cargo.toml",
    "stellar:mainnet:preflight": "node scripts/stellar-mainnet-preflight.mjs --wasm contracts/chain_duel_mainnet/target/wasm32v1-none/release/chain_duel_mainnet.wasm",
    "stellar:mainnet:prepare": "node scripts/stellar-mainnet-deploy.mjs --prepare",
    "stellar:mainnet:verify": "node scripts/stellar-mainnet-deploy.mjs --verify",
    "test:deployment:mainnet": "node --test scripts/stellar-mainnet-deployment.test.mjs",
    "stellar:setup": "node scripts/setup-testnet.mjs",
    "stellar:deploy": "node scripts/deploy-contract.mjs",
    "db:seed": "node scripts/seed.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:all": "npm run verify && npm run test:contract",
    "stellar:verify": "node scripts/verify-deployment.mjs",
    "treasury:fund": "node scripts/fund-treasury.mjs",
    "stellar:regression": "node scripts/stellar-regression.mjs",
    "arc:test": "forge test --root contracts/arc -vv",
    "arc:abi": "node scripts/arc-abi.mjs",
    "arc:review:manifest": "node scripts/arc-build-manifest.mjs",
    "arc:deploy:prepare": "node scripts/arc-deploy.mjs"
  },
  "dependencies": {
    "@circle-fin/user-controlled-wallets": "10.8.1",
    "@circle-fin/w3s-pw-web-sdk": "1.1.11",
    "@creit.tech/stellar-wallets-kit": "2.7.0",
    "@openzeppelin/contracts": "5.6.1",
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "17.2.1",
    "clsx": "2.1.1",
    "framer-motion": "14.0.0",
    "jose": "^6.1.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "viem": "2.58.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@circle-fin/w3s-pw-web-sdk": {
      "uuid": "11.1.1",
      "firebase": {
        "@grpc/grpc-js": "1.13.6",
        "undici": "6.29.1"
      }
    }
  }
}
