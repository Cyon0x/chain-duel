{
  "name": "chain-duel",
  "version": "1.0.0",
  "private": true,
  "description": "Chain Duel \u2014 premium 1v1 competitive arcade game powered by Stellar",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 4310",
    "dev:webpack": "next dev --webpack -p 4310",
    "build": "next build --webpack",
    "start": "next start -p 4310",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "cargo test --manifest-path contracts/chain_duel/Cargo.toml",
    "contract:wasm": "cargo build --manifest-path contracts/chain_duel/Cargo.toml --target wasm32v1-none --release",
    "stellar:setup": "node scripts/setup-testnet.mjs",
    "stellar:deploy": "node scripts/deploy-contract.mjs",
    "db:seed": "node scripts/seed.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:all": "npm run verify && npm run test:contract",
    "stellar:verify": "node scripts/verify-deployment.mjs",
    "treasury:fund": "node scripts/fund-treasury.mjs"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "2.7.0",
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "17.2.1",
    "clsx": "2.1.1",
    "framer-motion": "14.0.0",
    "jose": "^6.1.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "5.0.3"
  }
}
